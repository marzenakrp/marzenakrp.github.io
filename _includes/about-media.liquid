{%- comment -%}
  Media coverage list used on every language version of the About page.
  Article titles stay in their original language. Legend pill labels are pulled from
  _data/i18n/<lang>.yml so the surrounding chrome localizes correctly.
{%- endcomment -%}
{%- assign _lang = page.lang | default: site.lang -%}
{%- assign _i18n = site.data.i18n[_lang] | default: site.data.i18n.en -%}

